---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogPost from '../components/BlogPost.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Greeting from '../components/Greeting.jsx';

const pageTitle = 'Moïse Stéphane KINYOK | Ingénierie informatique';
const featuredPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const githubProjects = [
  {
    number: '01',
    category: 'Automatisation & data',
    title: 'Agent de suivi des prix Ryanair',
    description:
      'Un agent Python qui surveille des itinéraires, compare les prix et déclenche une alerte lorsqu’un tarif cible ou une baisse significative est détecté.',
    tags: ['Python', 'Playwright', 'SerpAPI', 'Pytest'],
    repositoryUrl: 'https://github.com/StephaneMk/ryanair-price-agent',
    mark: 'FLY',
    tone: 'blue' as const,
  },
  {
    number: '02',
    category: 'Application full-stack',
    title: 'AnimeStore',
    description:
      'Une plateforme e-commerce complète avec catalogue, commandes, réservations, fidélité, recommandations et espace d’administration sécurisé.',
    tags: ['React', 'Node.js', 'Express', 'MySQL', 'JWT'],
    repositoryUrl: 'https://github.com/StephaneMk/animestore-fullstack',
    mark: 'AS',
    tone: 'pink' as const,
  },
  {
    number: '03',
    category: 'Web & base de données',
    title: 'Gestion de concours de dessins',
    description:
      'Une application académique gérant concours, inscriptions, dépôts, jurys, évaluations et résultats grâce à des espaces adaptés à chaque rôle.',
    tags: ['PHP', 'MySQL', 'PDO', 'Modélisation', 'Sécurité'],
    repositoryUrl: 'https://github.com/StephaneMk/gestion-concours-dessins',
    mark: 'SQL',
    tone: 'cyan' as const,
  },
  {
    number: '04',
    category: 'Développement mobile',
    title: 'Application Android de calcul d’IMC',
    description:
      'Une application Java avec saisie contrôlée, calcul et interprétation de l’IMC, mémorisation locale du résultat et partage par e-mail.',
    tags: ['Android', 'Java', 'Gradle', 'Material UI'],
    repositoryUrl: 'https://github.com/StephaneMk/project-imc-android',
    mark: 'IMC',
    tone: 'navy' as const,
  },
];
---

<BaseLayout
  pageTitle={pageTitle}
  description="Portfolio de Moïse Stéphane KINYOK : production et observabilité, Elastic Stack, automatisation, data et systèmes d’information."
  showPageTitle={false}
  pageClass="home-page"
>
  <section class="editorial-hero" aria-labelledby="hero-title">
    <p class="hero-watermark" aria-hidden="true">INGÉNIERIE</p>

    <div class="container hero-topline">
      <p class="profile-pill hero-enter hero-enter--one">
        <span aria-hidden="true"></span>
        Moïse Stéphane KINYOK · Angers
      </p>
      <p class="hero-year hero-enter hero-enter--two">Portfolio / 2026</p>
    </div>

    <div class="container editorial-hero__grid">
      <div class="editorial-hero__copy">
        <p class="eyebrow hero-enter hero-enter--two">Alternant production & observabilité · CNP Assurances</p>
        <h1 id="hero-title" class="hero-title">
          <span class="hero-enter hero-enter--one">Construire.</span>
          <span class="hero-enter hero-enter--two">Comprendre.</span>
          <span class="hero-enter hero-enter--three"><em>Optimiser.</em></span>
        </h1>
        <p class="hero-lead hero-enter hero-enter--three">
          À l’ESEO et chez CNP Assurances, j’associe supervision, données et
          automatisation pour rendre les services numériques plus fiables.
        </p>
        <div class="button-row hero-enter hero-enter--three">
          <a class="button button--accent" href="#projets">
            Voir mes projets <span aria-hidden="true">↘</span>
          </a>
          <a class="button button--ghost" href="/about/">Découvrir mon profil</a>
        </div>
      </div>

      <figure class="editorial-hero__visual hero-enter hero-enter--two" data-parallax>
        <div class="hero-photo">
          <img
            src="/images/hero-ingenierie-informatique.jpg"
            alt="Poste de travail réel d’ingénierie informatique avec deux écrans, dont un affichant du code."
            width="4288"
            height="2848"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <div class="floating-stat floating-stat--top">
          <strong>500K+</strong>
          <span>lignes de données analysées</span>
        </div>
        <div class="floating-stat floating-stat--bottom">
          <span class="status-dot" aria-hidden="true"></span>
          <span>Basé à Angers</span>
        </div>
      </figure>
    </div>

    <a class="scroll-cue" href="#profil" aria-label="Continuer vers la présentation">
      <span>Explorer</span>
      <span aria-hidden="true">↓</span>
    </a>
  </section>

  <section id="profil" class="manifesto-section">
    <div class="container manifesto-grid">
      <p class="section-kicker" data-reveal>01 / Profil</p>
      <h2 data-reveal>
        Relier <em>observabilité</em>, données et automatisation pour fiabiliser
        les systèmes d’information.
      </h2>
      <div class="manifesto-copy" data-reveal="right">
        <p>
          Mon alternance en production chez CNP Assurances et ma formation à l’ESEO
          m’apprennent à superviser les services, qualifier les incidents et
          industrialiser des solutions utiles aux équipes métier.
        </p>
        <a class="text-link" href="/about/">Lire mon parcours <span aria-hidden="true">↗</span></a>
      </div>

      <ul class="metric-strip" aria-label="Chiffres clés" data-reveal>
        <li><strong>03</strong><span>tableaux de bord Power BI</span></li>
        <li><strong>30%</strong><span>de temps d’analyse économisé</span></li>
        <li><strong>2027</strong><span>diplôme d’ingénieur visé</span></li>
        <li><strong>955/990</strong><span>score TOEIC en anglais</span></li>
      </ul>
    </div>
  </section>

  <section id="expertises" class="process-section" aria-labelledby="expertises-title">
    <div class="container">
      <div class="editorial-heading" data-reveal>
        <p class="section-kicker">02 / Expertises</p>
        <h2 id="expertises-title">Mon terrain de jeu numérique</h2>
        <p>De la supervision des services à l’automatisation des contrôles et à l’analyse des données.</p>
      </div>

      <div class="process-grid">
        <article class="process-card process-card--image" data-reveal="left">
          <img src="/images/data-analyst.png" alt="Illustration d’un processus d’analyse de données." loading="lazy" />
          <span>Analyser</span>
        </article>
        <article class="process-card" data-reveal>
          <span class="process-card__number">01</span>
          <h3>Observabilité & SRE</h3>
          <p>Elastic Stack, Kibana, KQL, OMi, Control-M, ServiceNow et analyse d’incidents.</p>
        </article>
        <article class="process-card" data-reveal>
          <span class="process-card__number">02</span>
          <h3>Automatisation & DevOps</h3>
          <p>Python, Shell/ksh, GitLab, Ansible, Docker, Elastic Transforms et Watcher.</p>
        </article>
        <article class="process-card process-card--accent" data-reveal="right">
          <span class="process-card__number">03</span>
          <h3>Données & systèmes</h3>
          <p>MySQL, PostgreSQL, Oracle, Pandas, Power BI, Linux, Azure et Machine Learning.</p>
        </article>
        <article class="process-card process-card--wide" data-reveal>
          <p class="eyebrow">Méthode</p>
          <h3>Observer → détecter → automatiser → fiabiliser.</h3>
        </article>
      </div>
    </div>
  </section>

  <section id="projets" class="showcase-section" aria-labelledby="projects-title">
    <div class="container">
      <div class="editorial-heading editorial-heading--dark" data-reveal>
        <p class="section-kicker">03 / Projets</p>
        <h2 id="projects-title">Expériences sélectionnées</h2>
        <a class="text-link" href="/blog/">Voir tous les articles <span aria-hidden="true">↗</span></a>
      </div>

      <ul class="post-grid post-grid--editorial" role="list">
        {featuredPosts.map((post) => (
          <BlogPost
            url={`/posts/${post.id}/`}
            title={post.data.title}
            description={post.data.description}
            image={post.data.image}
            logo={post.data.logo}
            tags={post.data.tags}
            pubDate={post.data.pubDate}
          />
        ))}
      </ul>

      <div class="github-projects-heading" data-reveal>
        <div>
          <p class="section-kicker">Projets récents · GitHub</p>
          <h3>Quatre applications, quatre terrains d’apprentissage.</h3>
        </div>
        <p>
          Automatisation, e-commerce, système d’information et mobile : ces projets
          complètent les expériences présentées plus haut avec des réalisations concrètes.
        </p>
      </div>

      <ul class="github-project-grid" role="list">
        {githubProjects.map((project) => <ProjectCard {...project} />)}
      </ul>
    </div>
  </section>

  <section class="lab-section">
    <div class="container lab-grid">
      <div data-reveal="left">
        <p class="section-kicker">04 / Interaction</p>
        <p class="lab-watermark" aria-hidden="true">HELLO</p>
        <h2>Un portfolio qui réagit, sans devenir compliqué.</h2>
      </div>
      <div class="interactive-card" data-reveal="right">
        <Greeting
          client:load
          messages={["Salut", "Bonjour", "Bienvenue", "Coucou"]}
        />
      </div>
    </div>
  </section>

  <section class="contact-banner">
    <div class="container contact-banner__inner" data-reveal>
      <p class="section-kicker">05 / Contact</p>
      <h2>Parlons d’une idée, d’un projet ou de technologie.</h2>
      <a class="button button--light" href="mailto:stephanekinyok26@gmail.com">
        Me contacter <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</BaseLayout>
