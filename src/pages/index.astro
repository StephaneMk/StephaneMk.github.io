---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import heroImage from '../assets/images/hero-ingenierie-informatique.jpg';
import dataAnalystImage from '../assets/images/data-analyst.png';
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogPost from '../components/BlogPost.astro';
import ProjectCard from '../components/ProjectCard.astro';

const pageTitle = 'Moïse Stéphane KINYOK | Data / Business Analyst';
const featuredPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const githubProjects = [
  {
    number: '01',
    category: 'Automatisation & data',
    title: 'Agent de suivi des prix Ryanair',
    description:
      'Un agent Python qui surveille des itinéraires, compare les prix et déclenche une alerte lorsqu’un tarif cible ou une baisse significative est détecté.',
    tags: ['Python', 'Playwright', 'SerpAPI', 'Pytest'],
    mark: 'FLY',
  },
  {
    number: '02',
    category: 'Application full-stack',
    title: 'AnimeStore',
    description:
      'Une plateforme e-commerce complète avec catalogue, commandes, réservations, fidélité, recommandations et espace d’administration sécurisé.',
    tags: ['React', 'Node.js', 'Express', 'MySQL', 'JWT'],
    mark: 'AS',
  },
  {
    number: '03',
    category: 'Web & base de données',
    title: 'Gestion de concours de dessins',
    description:
      'Une application académique gérant concours, inscriptions, dépôts, jurys, évaluations et résultats grâce à des espaces adaptés à chaque rôle.',
    tags: ['PHP', 'MySQL', 'PDO', 'Modélisation', 'Sécurité'],
    mark: 'SQL',
  },
  {
    number: '04',
    category: 'Développement mobile',
    title: 'Application Android de calcul d’IMC',
    description:
      'Une application Java avec saisie contrôlée, calcul et interprétation de l’IMC, mémorisation locale du résultat et partage par e-mail.',
    tags: ['Android', 'Java', 'Gradle', 'Material UI'],
    mark: 'IMC',
  },
];
---

<BaseLayout
  pageTitle={pageTitle}
  description="Portfolio de Moïse Stéphane KINYOK, Data / Business Analyst en alternance chez CNP Assurances : besoins métier, SQL Oracle, suite Elastic, tableaux de bord et qualité des données."
  showPageTitle={false}
  pageClass="home-page"
>
  <section class="editorial-hero" aria-labelledby="hero-title">
    <p class="hero-watermark" aria-hidden="true">INGÉNIERIE</p>

    <div class="container hero-topline">
      <p class="profile-pill hero-enter hero-enter--one">
        <span aria-hidden="true"></span>
        Moïse Stéphane KINYOK · Angers
      </p>
      <p class="hero-year hero-enter hero-enter--two">Portfolio / 2026</p>
    </div>

    <div class="container editorial-hero__grid">
      <div class="editorial-hero__copy">
        <p class="eyebrow hero-enter hero-enter--two">Data / Business Analyst en alternance · CNP Assurances</p>
        <h1 id="hero-title" class="hero-title">
          <span class="hero-enter hero-enter--one">Comprendre.</span>
          <span class="hero-enter hero-enter--two">Analyser.</span>
          <span class="hero-enter hero-enter--three"><em>Éclairer.</em></span>
        </h1>
        <p class="hero-lead hero-enter hero-enter--three">
          À l’ESEO et chez CNP Assurances, je traduis les besoins des équipes métier
          de l’assurance vie en données fiables et en indicateurs utiles à la décision.
        </p>
        <div class="button-row hero-enter hero-enter--three">
          <a class="button button--accent" href="#projets">
            Voir mes expériences et projets <span aria-hidden="true">↘</span>
          </a>
          <a class="button button--ghost" href="/about/">Découvrir mon profil</a>
        </div>
        <a
          class="text-link hero-cv-link hero-enter hero-enter--three"
          href="/CV_Moise_Stephane_KINYOK_Data_Business_Analyst.pdf"
          target="_blank"
          rel="noopener noreferrer"
        >
          Consulter mon CV (PDF) <span aria-hidden="true">↗</span>
          <span class="sr-only"> (nouvel onglet)</span>
        </a>
      </div>

      <figure class="editorial-hero__visual hero-enter hero-enter--two" data-parallax>
        <div class="hero-photo">
          <Image
            src={heroImage}
            alt="Poste de travail réel d’ingénierie informatique avec deux écrans, dont un affichant du code."
            widths={[640, 960, 1400, 1920]}
            sizes="(min-width: 64rem) 50vw, 100vw"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <div class="floating-stat floating-stat--top">
          <strong>500K+</strong>
          <span>lignes de données traitées</span>
        </div>
        <div class="floating-stat floating-stat--bottom">
          <span class="status-dot" aria-hidden="true"></span>
          <span>Basé à Angers</span>
        </div>
      </figure>
    </div>

    <a class="scroll-cue" href="#profil" aria-label="Continuer vers la présentation">
      <span>Explorer</span>
      <span aria-hidden="true">↓</span>
    </a>
  </section>

  <section id="profil" class="manifesto-section">
    <div class="container manifesto-grid">
      <p class="section-kicker" data-reveal>01 / Profil</p>
      <h2 data-reveal>
        Traduire les besoins <em>métier</em> en indicateurs fiables et utiles
        à la décision.
      </h2>
      <div class="manifesto-copy" data-reveal="right">
        <p>
          Chez CNP Assurances, j’analyse avec les équipes métier les parcours de gestion
          des contrats d’assurance vie, puis j’exploite les données pour suivre les
          opérations, repérer les anomalies et fournir des indicateurs utiles à leur
          prise en charge.
        </p>
        <p>
          Je recherche un premier emploi de Data / Business Analyst à partir de
          septembre 2027, dans l’assurance, la banque ou la finance.
        </p>
        <a class="text-link" href="/about/">Lire mon parcours <span aria-hidden="true">↗</span></a>
      </div>

      <ul class="metric-strip" aria-label="Chiffres clés" data-reveal>
        <li><strong>2 ans</strong><span>d’alternance en assurance vie</span></li>
        <li><strong>30 %</strong><span>de temps d’analyse économisé en stage</span></li>
        <li><strong>2027</strong><span>diplôme d’ingénieur visé</span></li>
        <li><strong>955/990</strong><span>score TOEIC en anglais</span></li>
      </ul>
    </div>
  </section>

  <section id="expertises" class="process-section" aria-labelledby="expertises-title">
    <div class="container">
      <div class="editorial-heading" data-reveal>
        <p class="section-kicker">02 / Expertises</p>
        <h2 id="expertises-title">Mon terrain de jeu numérique</h2>
        <p>Du besoin d’une équipe à l’indicateur qu’elle utilise : comprendre, collecter, analyser, restituer.</p>
      </div>

      <div class="process-grid">
        <article class="process-card process-card--image" data-reveal="left">
          <Image
            src={dataAnalystImage}
            alt="Illustration d’un processus d’analyse de données."
            widths={[480, 800, 1200]}
            sizes="(min-width: 64rem) 30vw, 100vw"
            loading="lazy"
          />
          <span>Analyser</span>
        </article>
        <article class="process-card process-card--accent" data-reveal>
          <span class="process-card__number">01</span>
          <h3>Besoins métier</h3>
          <p>Parcours de gestion, produits, codes programmes et actes de gestion, traduits en indicateurs et en contrôles.</p>
        </article>
        <article class="process-card" data-reveal>
          <span class="process-card__number">02</span>
          <h3>Données & qualité</h3>
          <p>SQL Oracle, Logstash, Python, Pandas, Transforms et détection d’anomalies avec Elastic Machine Learning.</p>
        </article>
        <article class="process-card" data-reveal="right">
          <span class="process-card__number">03</span>
          <h3>Reporting & restitution</h3>
          <p>Kibana, Power BI, Excel / Power Query, alertes Watcher et vues OMi adaptées à chaque équipe.</p>
        </article>
        <article class="process-card process-card--wide" data-reveal>
          <p class="eyebrow">Méthode</p>
          <h3>Comprendre le besoin → trouver la donnée → construire l’indicateur → le diffuser.</h3>
        </article>
      </div>
    </div>
  </section>

  <section id="projets" class="showcase-section" aria-labelledby="projects-title">
    <div class="container">
      <div class="editorial-heading editorial-heading--dark" data-reveal>
        <p class="section-kicker">03 / Réalisations</p>
        <h2 id="projects-title">Expériences et projets</h2>
        <a class="text-link" href="/blog/">Voir tous les articles <span aria-hidden="true">↗</span></a>
      </div>

      <ul class="post-grid post-grid--editorial" role="list">
        {featuredPosts.map((post) => (
          <BlogPost
            url={`/posts/${post.id}/`}
            title={post.data.title}
            description={post.data.description}
            image={post.data.image}
            logo={post.data.logo}
            tags={post.data.tags}
            pubDate={post.data.pubDate}
          />
        ))}
      </ul>

      <div class="github-projects-heading" data-reveal>
        <div>
          <p class="section-kicker">Projets récents · GitHub</p>
          <h3>Quatre applications, quatre terrains d’apprentissage.</h3>
        </div>
        <p>
          Automatisation, e-commerce, système d’information et mobile : ces projets
          complètent les expériences présentées plus haut avec des réalisations concrètes.
        </p>
      </div>

      <ul class="github-project-grid" role="list">
        {githubProjects.map((project) => <ProjectCard {...project} />)}
      </ul>
    </div>
  </section>
</BaseLayout>
