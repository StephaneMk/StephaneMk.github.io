---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  pageTitle="Page introuvable | Moïse Stéphane KINYOK"
  description="Cette page n’existe pas ou a été déplacée."
  showPageTitle={false}
  pageClass="not-found-page"
>
  <section class="container not-found" aria-labelledby="not-found-title">
    <p class="section-kicker">Erreur 404</p>
    <h1 id="not-found-title">Cette page est introuvable.</h1>
    <p>
      Le lien est peut-être ancien ou l’adresse contient une faute de frappe.
      Vous pouvez repartir de l’accueil ou parcourir les articles.
    </p>
    <div class="button-row">
      <a class="button button--accent" href="/">Retour à l’accueil</a>
      <a class="text-link" href="/blog/">Voir le blog <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    gap: 1.5rem;
    max-width: 48rem;
    padding-block: clamp(5rem, 14vw, 10rem) clamp(6rem, 16vw, 12rem);
  }

  .not-found h1 {
    font-size: clamp(3rem, 8vw, 6.5rem);
  }

  .not-found > p:not(.section-kicker) {
    max-width: 38rem;
    color: var(--muted);
    font-size: 1.15rem;
  }

  .not-found .button-row {
    align-items: center;
  }
</style>
