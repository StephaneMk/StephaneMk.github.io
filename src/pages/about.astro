---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "À propos de moi";

const identity = {
  firstName: "Moïse Stéphane KINYOK",
  country: "France",
  city: "Angers",
  hobbies: ["lecture", "nouvelles technologies", "voyages", "course", "football"],
};

const competencies = [
  "Analyse des besoins métier",
  "Analyse et qualité des données",
  "Reporting et tableaux de bord",
  "Détection d’anomalies et Machine Learning",
  "Accompagnement des utilisateurs",
  "Gestion de projet et coordination technique",
  "Modélisation de données (Merise)",
  "Recette et tests fonctionnels",
];

const skills = [
  "Données et BI : SQL, Python, Pandas, Power BI, Excel / Power Query, NLP",
  "Bases de données : Oracle, MySQL, PostgreSQL, MariaDB",
  "Écosystème Elastic : Elasticsearch, Kibana, Logstash, Data Views, Transforms, Watcher, Elastic ML, KQL, ES|QL, Lucene, Saved Objects (migration dev / recette)",
  "Supervision et exploitation SI : OMi, BMC Control-M, Operations Orchestration, ServiceNow",
  "DevOps, systèmes et cloud : Git, GitLab, GitHub, Ansible, Docker, Vagrant, VirtualBox, Unix / Linux, Azure",
  "Programmation : Java, C, Ruby, Shell / KSH, JavaScript, PHP, Django, Android",
];

const qualities = [
  "Rigueur et esprit critique",
  "Esprit d’équipe et communication",
  "Autonomie et méthodes agiles",
  "Adaptabilité et curiosité",
];

const engineeringDegreeCompleted = false;
const graduationYear = 2027;
---

<BaseLayout pageTitle={pageTitle}>
  <div class="about-page container">
    <section class="about-intro" aria-labelledby="about-intro-title">
      <div data-reveal="left">
        <p class="eyebrow">Profil · Données · Besoins métier</p>
        <h2 id="about-intro-title">
          Je transforme les besoins métier en indicateurs fiables et utiles à la décision.
        </h2>
      </div>

      <div class="about-intro__copy" data-reveal="right">
        <p>
          Je m’appelle {identity.firstName}. Basé à {identity.city}, je suis élève-ingénieur à l’ESEO,
          spécialisé en informatique et systèmes d’information. Depuis septembre 2025, je suis en
          alternance chez CNP Assurances, où j’associe analyse de données et compréhension du métier
          de l’assurance vie.
        </p>
        <p>
          Je comprends les parcours de gestion des contrats et les besoins des équipes, puis j’exploite
          les données pour suivre les opérations, identifier les anomalies et fournir des indicateurs
          utiles à leur prise en charge. Je souhaite mettre cette double compétence métier et data au
          service de l’assurance, de la banque et de la finance, et je recherche un premier emploi de
          Data / Business Analyst à partir de septembre {graduationYear}.
        </p>
      </div>
    </section>

    <nav class="about-nav" aria-label="Accès rapide aux sections du profil" data-reveal>
      <a href="#competences">Compétences</a>
      <a href="#parcours">Parcours professionnel</a>
      <a href="#projets-techniques">Projets</a>
      <a href="#formation">Formation</a>
      <a href="#langues">Langues et certification</a>
      <a href="#atouts">Atouts</a>
      <a href="#interets">Centres d’intérêt</a>
    </nav>

    <section class="about-grid" aria-label="Parcours et compétences">
      <article class="panel panel--accent" data-reveal="left">
        <p class="eyebrow">En quelques mots</p>
        <h2>Un profil data et métier</h2>
        <p>
          Mon parcours associe une formation scientifique à l’ESEO, un stage de Data Analyst
          et une alternance de deux ans dans l’assurance vie chez CNP Assurances.
        </p>
        <dl class="profile-facts">
          <div>
            <dt>Localisation</dt>
            <dd>{identity.city}, {identity.country}</dd>
          </div>
          <div>
            <dt>Formation actuelle</dt>
            <dd>Cycle ingénieur à l’ESEO</dd>
          </div>
          <div>
            <dt>Diplôme visé</dt>
            <dd>{graduationYear}</dd>
          </div>
          <div>
            <dt>Recherche</dt>
            <dd>Premier emploi dès septembre {graduationYear}</dd>
          </div>
          <div>
            <dt>Secteurs visés</dt>
            <dd>Assurance, banque, finance</dd>
          </div>
          <div>
            <dt>Mode de travail</dt>
            <dd>Hybride : télétravail et sur site · permis B</dd>
          </div>
        </dl>
        {!engineeringDegreeCompleted && (
          <p class="status-note">Formation d’ingénieur en cours, diplomation prévue en {graduationYear}.</p>
        )}
        <a
          class="text-link profile-cv-link"
         href="/cv/">
          Consulter mon CV <span aria-hidden="true">↗</span>
        </a>
      </article>

      <article id="competences" class="panel" data-reveal="right">
        <p class="eyebrow">Compétences et outils</p>
        <h2>Ma boîte à outils</h2>
        <ul class="competency-list">
          {competencies.map((competency) => <li>{competency}</li>)}
        </ul>
        <ul class="skill-list" aria-label="Outils informatiques">
          {skills.map((skill) => <li class="skill">{skill}</li>)}
        </ul>
      </article>
    </section>

    <section id="parcours" class="about-section" aria-labelledby="experience-title">
      <div class="section-heading" data-reveal>
        <p class="eyebrow">Expériences</p>
        <h2 id="experience-title">Parcours professionnel</h2>
        <p>Depuis 2025</p>
      </div>

      <div class="career-list">
        <article class="career-item" data-reveal>
          <p class="career-item__date">Depuis septembre 2025</p>
          <div>
            <p class="eyebrow">CNP Assurances · Angers</p>
            <h3>Data / Business Analyst en alternance</h3>
            <ul>
              <li>Recueil et analyse des besoins de plusieurs équipes métier (gestion, support aux opérations clients, études) sur les parcours de gestion des contrats d’assurance vie : produits, codes programmes, codes contractuels et actes de gestion, afin de définir les données à exploiter et les indicateurs de suivi.</li>
              <li>Conception de requêtes SQL sur plusieurs bases relationnelles Oracle et mise en place de pipelines ETL (Logstash) pour alimenter un suivi de bout en bout : état de chaque demande client à chaque étape du cycle de vie d’un acte de gestion, contrats impactés et codes erreur associés.</li>
              <li>Création de Data Views et de tableaux de bord Kibana sur les volumes de contrats arrivés et bloqués, les montants et les ruptures de flux, construits à partir de la connaissance métier pour aider les équipes à prioriser les dossiers à traiter.</li>
              <li>Mise en place d’une supervision de masse avec Elastic Machine Learning, à partir des données de supervision technique existantes, pour analyser les tendances et détecter automatiquement les hausses, baisses et ruptures anormales de volumes et de montants.</li>
              <li>Contrôle qualité des données : participation active à la conception d’une requête et d’un Transform Elasticsearch isolant les contrats sans RIB dans l’acte de gestion rachat partiel, pour orienter les équipes directement vers les dossiers à corriger.</li>
              <li>Diffusion des résultats : alertes Watcher vers Teams, remontée des contrats en anomalie et de leurs erreurs vers l’hyperviseur OMi, compte de consultation pour les équipes études, vues OMi sur mesure et formation des utilisateurs à la recherche, à la catégorisation des anomalies et à la création de tickets ServiceNow.</li>
              <li>Validation et livraison : développement, migration objet par objet et tests en recette, versionnement de l’ensemble des objets sous GitLab et préparation des artefacts avec l’équipe DevOps pour un déploiement Ansible conforme aux normes internes.</li>
            </ul>
            <a class="text-link" href="/posts/post-5/">Lire mon retour d’expérience chez CNP <span aria-hidden="true">↗</span></a>
          </div>
        </article>

        <article class="career-item" data-reveal>
          <p class="career-item__date">Juillet–août 2024</p>
          <div>
            <p class="eyebrow">Groupe KIM Cameroun · Yaoundé</p>
            <h3>Data Analyst junior en stage</h3>
            <ul>
              <li>Extraction et transformation de plus de 500 000 lignes de données MySQL avec Python et Pandas : nettoyage, dédoublonnage et contrôles de cohérence pour fiabiliser les données avant analyse.</li>
              <li>Création de 3 tableaux de bord dynamiques sous Power BI pour l’analyse métier, avec indicateurs clés et filtres adaptés aux questions des équipes opérationnelles.</li>
              <li>Automatisation de rapports récurrents sous Excel (Power Query), réduisant le temps d’analyse de 30 % et limitant les erreurs de saisie manuelle.</li>
              <li>Extraction automatique de données numérisées et résumé de comptes rendus avec le NLP.</li>
            </ul>
          </div>
        </article>

        <article class="career-item" data-reveal>
          <p class="career-item__date">Sept. 2023–juin 2024</p>
          <div>
            <p class="eyebrow">Confédération des Junior-Entreprises · Yaoundé</p>
            <h3>Entrepreneur Junior</h3>
            <p>
              Création d’une entreprise virtuelle de vente de jus naturels : gestion d’équipe,
              business model, budget, financement et stratégie marketing.
            </p>
          </div>
        </article>

        <article class="career-item" data-reveal>
          <p class="career-item__date">Juillet–août 2023</p>
          <div>
            <p class="eyebrow">T&amp;T CALY SARL · Yaoundé</p>
            <h3>Assistant technique</h3>
            <p>
              Réalisation de maquettes en bois, travaux de design sur Photoshop et gestion des stocks
              avec des fiches de suivi, dans le respect des délais.
            </p>
          </div>
        </article>
      </div>
    </section>

    <section class="about-grid" aria-label="Projets et formation">
      <article id="projets-techniques" class="panel" data-reveal="left">
        <p class="eyebrow">Projet technique</p>
        <h2>Infrastructure, réseau et bases de données</h2>
        <p>
          Architecture réseau à 3 VLAN avec routage sous Cisco Packet Tracer, machine virtuelle
          Linux sur Azure et deux sites Apache sécurisés par certificats SSL Let’s Encrypt.
        </p>
        <p>
          Administration MariaDB (2 bases, une dizaine de comptes et rôles), une quinzaine de requêtes
          SQL complexes, 5 scripts de nettoyage et de transformation, indexation et sauvegardes
          automatisées quotidiennes.
        </p>
        <a class="text-link" href="/posts/post-2/">Lire le détail du projet <span aria-hidden="true">↗</span></a>
      </article>

      <article id="formation" class="panel" data-reveal="right">
        <p class="eyebrow">Formation</p>
        <h2>Un parcours scientifique et technique</h2>
        <ol class="education-list">
          <li>
            <strong>ESEO, Angers</strong>
            <span>Diplôme d’ingénieur généraliste, spécialité systèmes d’information · 2024–{graduationYear}</span>
          </li>
          <li>
            <strong>Prépas Internationales, Yaoundé</strong>
            <span>Classe préparatoire MPSI · 2022–2024</span>
          </li>
          <li>
            <strong>Lycée Général Leclerc, Yaoundé</strong>
            <span>Baccalauréat C · 2022</span>
          </li>
        </ol>
      </article>
    </section>

    <section id="langues" class="about-grid" aria-label="Langues et certification">
      <article class="panel" data-reveal="left">
        <p class="eyebrow">Langues</p>
        <h2>Communiquer en français et en anglais</h2>
        <ul class="education-list">
          <li><strong>Français</strong><span>Langue maternelle</span></li>
          <li><strong>Anglais</strong><span>TOEIC : 955/990</span></li>
        </ul>
      </article>

      <article class="panel" data-reveal="right">
        <p class="eyebrow">Certification</p>
        <h2>Gestion de projet</h2>
        <p>MOOC de gestion de projet, en complément des méthodes agiles et de la coordination technique pratiquées en équipe.</p>
      </article>
    </section>

    <section id="atouts" class="panel about-qualities" aria-labelledby="qualities-title" data-reveal>
      <div>
        <p class="eyebrow">Ma façon de travailler</p>
        <h2 id="qualities-title">Curieux, structuré et orienté collectif</h2>
        <p>
          J’aime comprendre un problème dans son ensemble, apprendre rapidement et partager une solution
          claire avec l’équipe.
        </p>
      </div>
      <ul class="tag-list" aria-label="Qualités professionnelles">
        {qualities.map((quality) => <li>{quality}</li>)}
      </ul>
    </section>

    <section id="interets" class="about-interests" aria-labelledby="interests-title" data-reveal>
      <p class="eyebrow">Au-delà du code</p>
      <h2 id="interests-title">Ce qui nourrit ma curiosité</h2>
      <p>
        Parmi mes centres d’intérêt : {identity.hobbies.slice(0, -1).join(", ")} et {identity.hobbies.at(-1)}.
      </p>
    </section>
  </div>
</BaseLayout>
