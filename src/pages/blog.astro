---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogPost from '../components/BlogPost.astro';

const allPosts = (await getCollection('blog')).sort(
	(postA, postB) => postB.data.pubDate.valueOf() - postA.data.pubDate.valueOf(),
);

const pageTitle = "Le blog informatique de Moïse Stéphane KINYOK";
---

<BaseLayout pageTitle={pageTitle} eyebrow="Notes, projets et retours d’expérience">
	<section class="blog-page container">
		<header class="blog-intro" data-reveal>
			<p class="blog-intro__eyebrow">Journal d’ingénierie</p>
			<p class="blog-intro__lead">
				Je partage ici mes expériences en analyse de données et besoins métier, mes projets de systèmes
				d’information et mon parcours d’élève ingénieur à l’ESEO.
			</p>
		</header>

		<section class="blog-feed" aria-labelledby="articles-heading">
			<div class="blog-feed__heading" data-reveal>
				<p class="blog-feed__eyebrow">Projets et expériences</p>
				<h2 id="articles-heading">Mes derniers articles</h2>
				<p>{allPosts.length} articles pour découvrir ma pratique et mes apprentissages.</p>
			</div>

			<ul class="blog-grid">
				{allPosts.map((post) => (
					<BlogPost
						url={`/posts/${post.id}/`}
						title={post.data.title}
						description={post.data.description}
						image={post.data.image}
						logo={post.data.logo}
						tags={post.data.tags}
						pubDate={post.data.pubDate}
					/>
				))}
			</ul>
		</section>
	</section>
</BaseLayout>
