---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Emblem from '../components/Emblem.astro';
import ProjectCard from '../components/ProjectCard.astro';
import portrait from '../assets/images/kim.jpeg';
import supportBanner from '../assets/brand/support-banner.png';
import supportReadme from '../assets/brand/support-readme.png';
import supportPost from '../assets/brand/support-post.png';
import supportSlide from '../assets/brand/support-slide.png';
import supportCv from '../assets/brand/support-cv.png';
import featuredGithub from '../assets/brand/selection-github.png';
import featuredGitlab from '../assets/brand/selection-gitlab.png';
import featuredBrand from '../assets/brand/selection-brand.png';

const updated = '1er octobre 2026';

const supports = [
  { label: 'LinkedIn · bannière', size: '1584 × 396', image: supportBanner, layout: 'wide', widths: [800, 1584], sizes: '(min-width: 82rem) 80rem, 100vw', alt: 'Bannière LinkedIn marine : « Traduire les besoins métier en indicateurs fiables. », Data / Business Analyst, CNP Assurances, ESEO.' },
  { label: 'GitHub et GitLab · en-tête de README', size: '1584 × 396', image: supportReadme, layout: 'wide', widths: [800, 1584], sizes: '(min-width: 82rem) 80rem, 100vw', alt: 'En-tête de README crème avec l’emblème mk., mon nom, mon poste et les quatre étapes de ma méthode.' },
  { label: 'LinkedIn · post', size: '1080 × 1350', image: supportPost, layout: 'tall', widths: [540, 1080], sizes: '(min-width: 64rem) 30rem, 100vw', alt: 'Post LinkedIn : « La donnée est partout. Sa valeur commence quand elle devient fiable. », suivi de trois étapes numérotées.' },
  { label: 'Présentation · diapositive', size: '1920 × 1080', image: supportSlide, layout: 'side', widths: [800, 1600], sizes: '(min-width: 64rem) 48rem, 100vw', alt: 'Diapositive « Du besoin métier à l’usage. » avec les quatre étapes de ma méthode en cartes.' },
  { label: 'CV · en-tête A4', size: '1240 × 430', image: supportCv, layout: 'side', widths: [620, 1240], sizes: '(min-width: 64rem) 48rem, 100vw', alt: 'En-tête de CV : mon nom, Data / Business Analyst, une phrase de présentation et mes coordonnées professionnelles.' },
];

const featured = [
  { title: 'Explorer mon GitHub', href: 'https://github.com/StephaneMk', image: featuredGithub, alt: 'Miniature « Explorer mon GitHub. » avec le logo GitHub.' },
  { title: 'Explorer mon GitLab', href: 'https://gitlab.com/StephaneMk', image: featuredGitlab, alt: 'Miniature « Explorer mon GitLab. » avec le logo GitLab.' },
  { title: 'Explorer ma marque', href: '/brand/', image: featuredBrand, alt: 'Miniature « Explorer ma marque. » avec l’emblème mk.' },
];

const scales = [
  {
    name: 'Marine',
    note: 'Structure, titres, zones sombres',
    steps: [
      { label: 'Teinte', hex: '#f3f4f5', contrast: 'Fond' },
      { label: 'Teinte forte', hex: '#e1e4e7', contrast: 'Fond' },
      { label: 'Bordure', hex: '#c3c9cf', contrast: 'Décoratif' },
      { label: 'Ligne', hex: '#778292', contrast: '3,9:1', dark: true },
      { label: 'Signature', hex: '#071c39', contrast: '17:1', dark: true },
      { label: 'Texte', hex: '#0a1830', contrast: '17,7:1', dark: true },
    ],
  },
  {
    name: 'Rose',
    note: 'Accent unique : liens, boutons, résultat',
    steps: [
      { label: 'Teinte', hex: '#fcf4f7', contrast: 'Fond' },
      { label: 'Teinte forte', hex: '#f8e4ec', contrast: 'Fond' },
      { label: 'Bordure', hex: '#f2c9da', contrast: 'Décoratif' },
      { label: 'Ligne', hex: '#e183a9', contrast: '2,6:1' },
      { label: 'Signature', hex: '#c81d63', contrast: '5,5:1', dark: true },
      { label: 'Texte', hex: '#a3134f', contrast: '7,6:1', dark: true },
    ],
  },
];

const projects = [
  {
    number: '01',
    category: 'Automatisation & data',
    title: 'Agent de suivi des prix Ryanair',
    description: 'Un agent Python qui surveille des itinéraires, compare les prix et déclenche une alerte lorsqu’un tarif cible ou une baisse significative est détecté.',
    tags: ['Python', 'Playwright', 'SerpAPI', 'Pytest'],
    mark: 'FLY',
  },
  {
    number: '03',
    category: 'Web & base de données',
    title: 'Gestion de concours de dessins',
    description: 'Une application académique gérant concours, inscriptions, dépôts, jurys, évaluations et résultats grâce à des espaces adaptés à chaque rôle.',
    tags: ['PHP', 'MySQL', 'PDO', 'Modélisation', 'Sécurité'],
    mark: 'SQL',
  },
];

const statuses = [
  { label: 'En ligne', tone: 'ok', use: 'Profil ou projet publié et à jour.' },
  { label: 'En cours', tone: 'progress', use: 'Travail engagé, pas encore livré.' },
  { label: 'À aligner', tone: 'todo', use: 'À mettre à jour avec le positionnement actuel.' },
  { label: 'Dépôt privé', tone: 'neutral', use: 'Code non public, projet décrit sans lien.' },
];

const portraitTones = [
  { name: 'Ombre', hex: '#311c10', role: 'Les zones les plus sombres : proches du marine profond.' },
  { name: 'Cacao', hex: '#4f392a', role: 'Ton moyen foncé, jamais utilisé derrière du texte.' },
  { name: 'Bronze', hex: '#7f5641', role: 'Ton médian : il appelle un fond chaud plutôt qu’un blanc froid.' },
  { name: 'Caramel', hex: '#b3866e', role: 'Ton clair : il s’accorde au filet beige des bordures.' },
  { name: 'Lumière', hex: '#e3bba4', role: 'Les reflets : la famille de la crème du fond de page.' },
];

const radii = [
  { value: '999 px', css: '999px', use: 'Boutons, statuts, étiquettes' },
  { value: '1 rem', css: '1rem', use: 'Pastilles multilignes' },
  { value: '1,5 rem', css: '1.5rem', use: 'Cartes et visuels' },
  { value: '22 %', css: '22%', use: 'Emblème mk.' },
];

const presence = [
  { name: 'Portfolio', detail: 'stephanemk.github.io', href: '/', status: 'En ligne' },
  { name: 'Profil GitHub', detail: 'github.com/StephaneMk', href: 'https://github.com/StephaneMk', status: 'En ligne' },
  { name: 'Profil GitLab', detail: 'gitlab.com/StephaneMk', href: 'https://gitlab.com/StephaneMk', status: 'En ligne' },
  { name: 'LinkedIn', detail: 'linkedin.com/in/stephane-kinyok', href: 'https://www.linkedin.com/in/stephane-kinyok', status: 'En ligne' },
  { name: 'CV', detail: 'Version Data / Business Analyst', href: '/cv/', status: 'En ligne' },
];

const method = [
  { verb: 'Comprendre', text: 'Partir de la question d’une équipe : son parcours de gestion, ses produits, ses actes, ses contraintes.' },
  { verb: 'Trouver', text: 'Identifier la donnée qui y répond : dans quelle base, quelle table, quel champ.' },
  { verb: 'Construire', text: 'Collecter, fiabiliser et transformer la donnée en un indicateur lisible.' },
  { verb: 'Diffuser', text: 'Mettre l’indicateur entre les mains des équipes : tableau de bord, alerte, vue métier, formation.' },
];

const colors = [
  { name: 'Marine', token: '--navy', hex: '#071c39', role: 'Hero, en-têtes de page, carte mise en avant', contrast: 'Blanc dessus 17:1', dark: true },
  { name: 'Marine profond', token: '--navy-deep', hex: '#041328', role: 'Pied de page, visuels de projets', contrast: 'Blanc dessus 18,6:1', dark: true },
  { name: 'Rose profond', token: '--accent-deep', hex: '#c81d63', role: 'Accent sur clair, fond des boutons', contrast: '4,9:1 sur crème · blanc dessus 5,5:1', dark: true },
  { name: 'Rose vif', token: '--accent-bright', hex: '#ff6aa8', role: 'Accent sur fond sombre', contrast: '6,4:1 sur marine', dark: false },
  { name: 'Crème', token: '--cream', hex: '#f5f0e7', role: 'Fond de page', contrast: 'Encre dessus 15,6:1', dark: false },
  { name: 'Surface', token: '--surface', hex: '#fffdf9', role: 'Cartes et panneaux', contrast: 'Encre dessus 17,4:1', dark: false },
  { name: 'Encre', token: '--ink', hex: '#0a1830', role: 'Texte principal', contrast: '15,6:1 sur crème', dark: true },
  { name: 'Gris', token: '--muted', hex: '#5c6574', role: 'Texte secondaire', contrast: '5,2:1 sur crème', dark: true },
  { name: 'Filet', token: '--line', hex: '#d9d6cf', role: 'Bordures et séparateurs (décoratif)', contrast: 'Non porteur de texte', dark: false },
];

const typeScale = [
  { label: 'Titre hero', spec: 'Fraunces 400 · jusqu’à 144 px · interlignage 0,78', sample: 'Éclairer.', className: 'type-sample--hero' },
  { label: 'Titre de section', spec: 'Fraunces 400 · jusqu’à 102 px · interlettrage −4,5 %', sample: 'Mon terrain de jeu', className: 'type-sample--h2' },
  { label: 'Titre de carte', spec: 'Fraunces 400 · jusqu’à 38 px', sample: 'Suivi par contrat', className: 'type-sample--h3' },
  { label: 'Texte courant', spec: 'Geist 400 · 16 px · interlignage 1,65', sample: 'Je traduis les besoins des équipes métier en indicateurs utiles à la décision.', className: 'type-sample--body' },
  { label: 'Sur-titre', spec: 'Geist 800 · 11,7 px · capitales · interlettrage +18 %', sample: 'Données · Besoins métier', className: 'type-sample--eyebrow' },
];

const always = [
  'Un seul accent : le rose, en version profonde sur clair et vive sur sombre.',
  'Haut de page sombre, contenu crème, pied de page sombre.',
  'Titres en Fraunces, texte et interface en Geist.',
  'Des faits vérifiables : outils nommés, chiffres réels, rôle exact (« mis en place » ou « participé »).',
  'Vouvoiement du visiteur, « je » pour parler de mon travail, phrases en casse normale.',
  'Contrastes conformes AA pour tout texte.',
];

const never = [
  'De bleu, de cyan ou de dégradé violet décoratif.',
  'De section colorée isolée au milieu d’une page claire.',
  'D’effet de survol sur un élément qui n’est pas cliquable.',
  'De noms internes de projets, d’équipes ou d’applications de mon employeur.',
  'De chiffres arrondis ou inventés, ni de points d’exclamation.',
  'D’emblème déformé, recoloré hors palette ou placé sur un fond chargé.',
];
---

<BaseLayout
  pageTitle="Identité de marque | Moïse Stéphane KINYOK"
  description="Le guide d’identité de Moïse Stéphane KINYOK, Data / Business Analyst : supports, méthode, emblème, couleurs, cartes, statuts, signature visuelle, règles et fondations."
  showPageTitle={false}
  pageClass="brand-page"
>
  <header class="brand-hero on-dark">
    <div class="container brand-hero__grid">
      <div class="brand-hero__copy">
        <p class="eyebrow">Identité de marque · {updated}</p>
        <h1>Traduire les besoins métier en indicateurs <em>fiables.</em></h1>
        <p class="brand-hero__lead">
          Ce guide rassemble tout ce qui fait mon identité professionnelle : ma promesse, ma méthode
          de travail et les règles visuelles appliquées à mon portfolio, à mes profils et à mon CV.
        </p>
        <nav class="brand-hero__links" aria-label="Mes profils">
          <a class="button button--accent" href="/">Portfolio <span aria-hidden="true">↗</span></a>
          <a class="social-link" href="https://github.com/StephaneMk" target="_blank" rel="noreferrer">GitHub<span class="sr-only"> (nouvel onglet)</span></a>
          <a class="social-link" href="https://gitlab.com/StephaneMk" target="_blank" rel="noreferrer">GitLab<span class="sr-only"> (nouvel onglet)</span></a>
          <a class="social-link" href="https://www.linkedin.com/in/stephane-kinyok" target="_blank" rel="noreferrer">LinkedIn<span class="sr-only"> (nouvel onglet)</span></a>
        </nav>
      </div>

      <figure class="brand-id">
        <Image class="brand-id__photo" src={portrait} alt="Portrait de Moïse Stéphane KINYOK." width={320} loading="eager" />
        <figcaption>
          <Emblem size={44} />
          <span>
            <strong>Moïse Stéphane KINYOK</strong>
            <small>Data / Business Analyst · alternant chez CNP Assurances</small>
          </span>
        </figcaption>
      </figure>
    </div>
  </header>

  <div class="container brand-body">
    <section class="brand-section" aria-labelledby="supports-title">
      <div class="brand-section__head">
        <p class="section-kicker">01 / En un coup d’œil</p>
        <h2 id="supports-title">Une identité, tous les supports</h2>
        <p>Les vrais visuels, construits avec les mêmes couleurs, les mêmes polices et le même emblème. Ce que vous voyez ici est ce qui est publié.</p>
      </div>
      <div class="support-gallery">
        {supports.map((item) => (
          <figure class:list={['support', `support--${item.layout}`]}>
            <div class="support__frame">
              <Image src={item.image} alt={item.alt} widths={item.widths} sizes={item.sizes} />
            </div>
            <figcaption><strong>{item.label}</strong><span>{item.size}</span></figcaption>
          </figure>
        ))}
      </div>
      <div class="support-featured">
        <p class="support-featured__label"><strong>LinkedIn · miniatures de la section Sélection</strong><span>1200 × 627</span></p>
        <ul>
          {featured.map((item) => (
            <li>
              <a href={item.href} target={item.href.startsWith('http') ? '_blank' : undefined} rel={item.href.startsWith('http') ? 'noreferrer' : undefined}>
                <Image src={item.image} alt={item.alt} widths={[400, 700]} sizes="(min-width: 64rem) 26rem, 100vw" />
                <span>{item.title}<span class="sr-only">{item.href.startsWith('http') ? ' (nouvel onglet)' : ''}</span></span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
    <section class="brand-section" aria-labelledby="method-title">
      <div class="brand-section__head">
        <p class="section-kicker">02 / La méthode</p>
        <h2 id="method-title">Quatre verbes, du besoin à l’usage</h2>
        <p>Chaque mission suit la même boucle : elle commence par une question métier et se termine entre les mains d’une équipe.</p>
      </div>
      <ol class="method-grid">
        {method.map((step, index) => (
          <li>
            <span class="method-grid__number">{String(index + 1).padStart(2, '0')}</span>
            <h3>{step.verb}</h3>
            <p>{step.text}</p>
          </li>
        ))}
      </ol>
    </section>
    <section class="brand-section" aria-labelledby="emblem-title">
      <div class="brand-section__head">
        <p class="section-kicker">03 / L’emblème</p>
        <h2 id="emblem-title">Un monogramme et un point</h2>
        <p>
          Mes initiales en Fraunces italique, suivies d’un point rose : le même point qui ferme
          « Éclairer. » sur mon portfolio. Il signe une conclusion claire.
        </p>
      </div>
      <div class="emblem-grid">
        <figure><div class="emblem-stage emblem-stage--light"><Emblem size={112} title="Emblème marine" /></div><figcaption><strong>Marine</strong> Version principale, sur fond clair.</figcaption></figure>
        <figure><div class="emblem-stage emblem-stage--dark"><Emblem variant="cream" size={112} title="Emblème crème" /></div><figcaption><strong>Crème</strong> Sur fond sombre ou photo foncée.</figcaption></figure>
        <figure><div class="emblem-stage emblem-stage--light"><Emblem variant="accent" size={112} title="Emblème rose" /></div><figcaption><strong>Accent</strong> Usage ponctuel : avatar, favicon, badge.</figcaption></figure>
      </div>
      <ul class="rule-list">
        <li><strong>Taille minimale</strong> 24 px de côté à l’écran.</li>
        <li><strong>Zone de protection</strong> un quart de la largeur de l’emblème tout autour.</li>
        <li><strong>Forme fixe</strong> carré aux coins arrondis, jamais étiré ni pivoté.</li>
      </ul>
    </section>
    <section class="brand-section" aria-labelledby="colors-title">
      <div class="brand-section__head">
        <p class="section-kicker">04 / Couleurs</p>
        <h2 id="colors-title">Bleu nuit, crème et un seul accent</h2>
        <p>Des neutres bleu nuit pour la rigueur, une base crème pour la lisibilité, et le rose pour guider l’œil vers l’essentiel.</p>
      </div>
      <ul class="swatch-grid">
        {colors.map((color) => (
          <li>
            <span class:list={['swatch', { 'swatch--dark': color.dark }]} style={`background:${color.hex}`}>{color.hex}</span>
            <strong>{color.name}</strong>
            <code>{color.token}</code>
            <span>{color.role}</span>
            <span class="swatch-contrast">{color.contrast}</span>
          </li>
        ))}
      </ul>
      <div class="scale-block">
        <h3>Une gamme complète par couleur</h3>
        <p>Chaque couleur de marque se décline du fond très clair jusqu’au texte. Contraste mesuré sur blanc.</p>
        {scales.map((scale) => (
          <div class="scale">
            <p class="scale__name"><strong>{scale.name}</strong><span>{scale.note}</span></p>
            <ol class="scale__steps">
              {scale.steps.map((step) => (
                <li>
                  <span class:list={['scale__chip', { 'scale__chip--dark': step.dark }]} style={`background:${step.hex}`}></span>
                  <strong>{step.label}</strong>
                  <code>{step.hex}</code>
                  <span>{step.contrast}</span>
                </li>
              ))}
            </ol>
          </div>
        ))}
      </div>
    </section>
    <section class="brand-section" aria-labelledby="projects-title">
      <div class="brand-section__head">
        <p class="section-kicker">05 / Cartes projet</p>
        <h2 id="projects-title">Un visuel sobre, des faits précis</h2>
        <p>Chaque projet suit la même grille : un numéro, un statut, un monogramme sur fond marine, une catégorie, une phrase qui dit ce que fait le projet et les technologies réellement utilisées.</p>
      </div>
      <ul class="github-project-grid brand-projects" role="list">
        {projects.map((project) => <ProjectCard {...project} />)}
      </ul>
    </section>
    <section class="brand-section" aria-labelledby="states-title">
      <div class="brand-section__head">
        <p class="section-kicker">06 / États</p>
        <h2 id="states-title">Statuts et étiquettes</h2>
        <p>Deux formes, deux rôles. Un statut porte un point de couleur et un mot. Une étiquette nomme un outil, dans une pastille neutre.</p>
      </div>
      <div class="state-grid">
        <div class="state-card">
          <p class="component-card__label">Statuts</p>
          <ul class="status-list">
            {statuses.map((status) => (
              <li><span class:list={['status-pill', `status-pill--${status.tone}`]}>{status.label}</span><span>{status.use}</span></li>
            ))}
          </ul>
        </div>
        <div class="state-card">
          <p class="component-card__label">Étiquettes</p>
          <ul class="mini-tags" aria-label="Exemple d’étiquettes">
            <li>SQL Oracle</li><li>Logstash</li><li>Kibana</li><li>Elastic ML</li><li>Power BI</li><li>Python</li>
          </ul>
          <p class="state-note">Toujours le nom exact de l’outil, jamais une catégorie vague.</p>
        </div>
      </div>
      <h3 class="state-subtitle">En situation : mes profils</h3>
      <ul class="presence-grid">
        {presence.map((item) => (
          <li>
            <a href={item.href} target={item.href.startsWith('http') ? '_blank' : undefined} rel={item.href.startsWith('http') ? 'noreferrer' : undefined}>
              <span class:list={['status-pill', item.status === 'En ligne' ? 'status-pill--ok' : 'status-pill--todo']}>{item.status}</span>
              <strong>{item.name}</strong>
              <span>{item.detail}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
    <section class="brand-section" aria-labelledby="human-title">
      <div class="brand-section__head">
        <p class="section-kicker">07 / La couche humaine</p>
        <h2 id="human-title">Des tons tirés du portrait</h2>
        <p>Cinq tons mesurés sur ma photo. Ils ne colorent pas l’interface : ils expliquent pourquoi la page est crème plutôt que blanche, et pourquoi le portrait est toujours posé sur un fond sombre.</p>
      </div>
      <div class="human-grid">
        <figure class="human-photo">
          <Image src={portrait} alt="Portrait de Moïse Stéphane KINYOK, sur fond sombre." width={360} />
        </figure>
        <ol class="tone-list">
          {portraitTones.map((tone) => (
            <li>
              <span class="tone-chip" style={`background:${tone.hex}`}></span>
              <strong>{tone.name}</strong>
              <code>{tone.hex}</code>
              <span>{tone.role}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>
    <section class="brand-section" aria-labelledby="signature-title">
      <div class="brand-section__head">
        <p class="section-kicker">08 / Signature visuelle</p>
        <h2 id="signature-title">Le schéma, plus que le logo</h2>
        <p>On reconnaît mon travail à la façon dont je dessine un flux : du besoin métier jusqu’à l’indicateur utilisé. La même grammaire partout : en-tête de README, posts, présentations et articles.</p>
      </div>
      <figure class="flow">
        <ol>
          <li><span>01</span><strong>Besoin métier</strong><em>La question de l’équipe</em></li>
          <li><span>02</span><strong>Donnée</strong><em>Base, table, champ</em></li>
          <li><span>03</span><strong>Traitement</strong><em>Requête, pipeline, contrôle</em></li>
          <li class="flow__result"><span>04</span><strong>Indicateur</strong><em>Utilisé par l’équipe</em></li>
        </ol>
        <figcaption>Étapes en pastilles, flèches roses, résultat toujours en rose. Un seul sens de lecture, du besoin vers l’indicateur.</figcaption>
      </figure>
      <div class="signature-grid">
        <figure class="chain">
          <figcaption>Version verticale, dans les articles</figcaption>
          <ol>
            <li><strong>Besoin métier</strong><span>On part de la question de l’équipe</span></li>
            <li><strong>Donnée</strong><span>Requête, pipeline, index</span></li>
            <li class="chain__result"><strong>Résultat</strong><span>Un indicateur utilisé par l’équipe</span></li>
          </ol>
        </figure>
        <ul class="rule-list rule-list--stack">
          <li><strong>Un schéma par étude de cas</strong> et un par article technique.</li>
          <li><strong>Des étapes nommées</strong> avec les mots du métier, pas ceux de l’outil.</li>
          <li><strong>Un seul résultat</strong> mis en avant, à la fin du flux.</li>
        </ul>
      </div>
    </section>
    <section class="brand-section" aria-labelledby="rules-title">
      <div class="brand-section__head">
        <p class="section-kicker">09 / Règles</p>
        <h2 id="rules-title">Ce qui ne bouge pas</h2>
        <p>Les règles qui gardent l’identité cohérente, page après page et profil après profil.</p>
      </div>
      <div class="do-dont">
        <div>
          <h3>Toujours</h3>
          <ul>{always.map((rule) => <li>{rule}</li>)}</ul>
        </div>
        <div>
          <h3>Jamais</h3>
          <ul>{never.map((rule) => <li>{rule}</li>)}</ul>
        </div>
      </div>
    </section>
    <section class="brand-section" aria-labelledby="tokens-title">
      <div class="brand-section__head">
