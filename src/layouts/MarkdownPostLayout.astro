---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';

interface Props {
  frontmatter: CollectionEntry<'blog'>['data'];
}

const { frontmatter } = Astro.props;

const formattedDate = frontmatter.pubDate.toLocaleDateString('fr-FR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<BaseLayout
  pageTitle={`${frontmatter.title} | Moïse Stéphane KINYOK`}
  description={frontmatter.description}
  showPageTitle={false}
  pageClass="article-page"
>
  <article>
    <header class="article-hero container">
      <a class="back-link" href="/blog/"><span aria-hidden="true">←</span> Retour au blog</a>

      <div class="article-hero__grid">
        <div class="article-hero__copy" data-reveal="left">
          <p class="eyebrow">Article · Retour d’expérience</p>
          <h1>{frontmatter.title}</h1>
          <p class="article-description">{frontmatter.description}</p>

          <div class="article-meta">
            <span>Par {frontmatter.author}</span>
            <time datetime={frontmatter.pubDate.toISOString()}>{formattedDate}</time>
          </div>

          <ul class="tag-list" aria-label="Étiquettes de l’article">
            {frontmatter.tags.map((tag) => (
              <li><a href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a></li>
            ))}
          </ul>
        </div>

        <div class="article-media" data-reveal="right">
          <Image
            class="article-image"
            src={frontmatter.image.url}
            alt={frontmatter.image.alt}
            widths={[640, 960, 1400]}
            sizes="(min-width: 64rem) 45vw, 100vw"
            loading="eager"
            fetchpriority="high"
          />
          {frontmatter.logo && (
            <Image
              class="article-logo"
              src={frontmatter.logo.url}
              alt={frontmatter.logo.alt}
              width={200}
            />
          )}
        </div>
      </div>
    </header>

    <div class="article-body container">
      <div class="prose" data-reveal>
        <slot />
      </div>

      <aside class="article-aside" data-reveal="right">
        <p class="eyebrow">À retenir</p>
        <p>Cet article présente une étape de mon parcours en ingénierie informatique et systèmes d’information.</p>
        <a class="text-link" href="/about/">Découvrir mon profil <span aria-hidden="true">→</span></a>
      </aside>
    </div>
  </article>
</BaseLayout>
