---
import { Image } from 'astro:assets';
import avatar from '../assets/images/kim.jpeg';
import Menu from './Menu.astro';
import Navigation from './Navigation.astro';
import ThemeIcon from './ThemeIcon.astro';
---

<header class="site-header">
  <div class="scroll-progress" aria-hidden="true">
    <span id="scroll-progress-bar"></span>
  </div>
  <div class="header-inner">
    <a class="brand" href="/" aria-label="Accueil — Portfolio de Moïse Stéphane KINYOK">
      <Image
        class="brand-avatar"
        src={avatar}
        alt=""
        width={96}
        loading="eager"
      />
      <span class="brand-copy">
        <strong>Moïse Stéphane KINYOK</strong>
        <small>Data / Business Analyst</small>
      </span>
    </a>

    <div class="header-actions">
      <Menu />
      <Navigation />
      <ThemeIcon />
    </div>
  </div>
</header>
