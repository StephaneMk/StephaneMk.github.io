---
import Social from './Social.astro';

const currentYear = new Date().getFullYear();
---

<footer class="site-footer on-dark">
  <div class="container footer-grid">
    <div>
      <p class="eyebrow">Restons en contact</p>
      <h2>Parlons d’une idée, d’un projet ou de technologie.</h2>
      <p>
        Une opportunité de Data / Business Analyst à partir de septembre 2027,
        une question sur mon parcours ou un projet ? Écrivez-moi.
      </p>
      <div class="button-row footer-actions">
        <a class="button button--accent" href="mailto:stephanekinyok26@gmail.com">
          Me contacter <span aria-hidden="true">↗</span>
        </a>
        <a
          class="text-link"
         href="/cv/">
          Consulter mon CV <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    <nav class="social-links" aria-label="Réseaux et contacts">
      <Social href="https://github.com/StephaneMk" label="GitHub" />
      <Social href="https://www.linkedin.com/in/stephane-kinyok" label="LinkedIn" />
      <Social href="/rss.xml" label="Flux RSS" />
    </nav>
  </div>

  <div class="container footer-bottom">
    <p>© {currentYear} Moïse Stéphane KINYOK</p>
    <a href="#main-content">Retour en haut <span aria-hidden="true">↑</span></a>
  </div>
</footer>
